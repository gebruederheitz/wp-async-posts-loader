{
    "name": "@gebruederheitz/wp-async-posts-loader",
    "version": "1.0.0",
    "description": "A loader to provide frontend functionality to the gebruederheitz/wp-async-posts-provider composer package",
    "main": "./src/load-more.js",
    "scripts": {
        "lint": "eslint vitest.config.mjs ./src ./test",
        "prettier:check": "prettier -c --config ./.prettierrc vitest.config.mjs \"./src/**/*.js\" \"./test/**/*.js\"",
        "release": "release-it --only-version",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gebruederheitz/wp-async-posts-loader.git"
    },
    "keywords": [
        "wordpress",
        "asynchronous",
        "ajax",
        "rest"
    ],
    "author": "Andreas Maros <andreas.maros@gebruederheitz.de>",
    "license": "GPL-3.0-only",
    "bugs": {
        "url": "https://github.com/gebruederheitz/wp-async-posts-loader/issues"
    },
    "homepage": "https://github.com/gebruederheitz/wp-async-posts-loader#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.8.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.6",
        "release-it": "^21.1.1",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "mitt": "^3.0.1"
    },
    "type": "module",
    "exports": {
        ".": "./src/load-more.js",
        "./package.json": "./package.json"
    },
    "sideEffects": false
}
